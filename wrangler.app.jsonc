{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aibeautystylist",
  "main": "src/worker.ts",
  "account_id": "9679290d9ad455c63c2002a90d381bf7",
  "compatibility_date": "2026-06-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
    "run_worker_first": [
      "/images/article-ai-tryon-comparison.webp",
      "/images/look-five-minute-beginner.webp",
      "/images/look-refined.webp",
      "/images/look-wedding-guest.webp",
      "/images/pinterest/quick-5min-real-morning.webp",
      "/images/pinterest/office-real-workday.webp",
      "/images/pinterest/date-night-real-candlelight.webp",
      "/images/pinterest/hooded-eyes-visible-shadow.webp",
    ],
  },
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "85c0b835a20847719af0256e50d7f726",
    },
  ],
  // Astro adapter 在构建阶段使用此文件（不含 main）。
  // 部署配置见 wrangler.jsonc。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-beauty-stylist-db",
      "database_id": "b4ca2fa7-49ea-410e-b802-bb710975d01a",
    },
  ],
  "r2_buckets": [
    {
      "binding": "USER_UPLOADS",
      "bucket_name": "ai-beauty-stylist-user-uploads",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "TRYON_JOBS_QUEUE",
        "queue": "aibeautystylist-tryon-jobs",
      },
    ],
  },
  "vars": {
    "APP_ENV": "production",
    "APP_PUBLIC_URL": "https://aibeautystylist.com",
    "AI_PROVIDER": "evolink",
    "UPLOAD_PROVIDER": "r2",
    "TRYON_PROVIDER": "evolink",
    "IMAGE_PROVIDER": "evolink",
    "ENABLE_CF_IMAGE_VARIANTS": "true",
    "EVOLINK_VISION_MODEL": "doubao-seed-2.0-lite",
    "EVOLINK_VISION_TIMEOUT_MS": "120000",
    "EVOLINK_IMAGE_MODEL": "qwen-image-edit-plus",
    "EVOLINK_IMAGE_FALLBACK_MODEL": "doubao-seedream-5.0-lite",
    "EVOLINK_ACQUISITION_IMAGE_MODEL": "doubao-seedream-5.0-pro",
    "EVOLINK_ACQUISITION_FALLBACK_IMAGE_MODEL": "gpt-image-2",
    "EVOLINK_PRIVATE_IMAGE_MODEL": "doubao-seedream-5.0-pro",
    "EVOLINK_PRIVATE_FALLBACK_IMAGE_MODEL": "gpt-image-2",
    "EVOLINK_IMAGE_TIMEOUT_MS": "180000",
    "SUPPORT_EMAIL": "support@aibeautystylist.com",
    "PINTEREST_GUEST_IP_DAILY_LIMIT": "3",
    "PINTEREST_GUEST_DAILY_LIMIT": "100",
  },
}
