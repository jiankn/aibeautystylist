---
import { t } from "../lib/i18n";

const avoidItems = [
  t("tryon", "photoGuideAvoidAngle"),
  t("tryon", "photoGuideAvoidDark"),
  t("tryon", "photoGuideAvoidCover"),
];
---

<details class="selfie-photo-guide">
  <summary>
    <span>{t("tryon", "photoTipsSummary")}</span>
    <small>{t("tryon", "uploadFormatDesc")}</small>
  </summary>
  <div class="selfie-photo-guide-text">
    <p>
      <strong>{t("tryon", "photoGuideGoodLabel")}</strong>
      <span>{t("tryon", "photoGuideGoodCaption")}</span>
    </p>
    <div class="selfie-photo-guide-avoid">
      <b>{t("tryon", "photoGuideAvoidTitle")}</b>
      <ul>
        {avoidItems.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</details>
