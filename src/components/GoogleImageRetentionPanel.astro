---
import {
  getGoogleImageRetentionContent,
  getGoogleImageRetentionPricingPath,
  getGoogleImageRetentionTryOnPath,
} from "../data/googleImageRetentionContent";
import { getLocalizedAppHref } from "../i18n/routing";

interface Props {
  englishPath: string;
  languageSlug: string;
  locale: string;
}

const { englishPath, languageSlug, locale } = Astro.props as Props;
const content = getGoogleImageRetentionContent(englishPath, locale);
const tryOnHref = content
  ? getLocalizedAppHref(
      getGoogleImageRetentionTryOnPath(content.topic),
      languageSlug,
    )
  : "";
const pricingHref = content
  ? getLocalizedAppHref(
      getGoogleImageRetentionPricingPath(content.topic),
      languageSlug,
    )
  : "";
---

{
  content && (
    <section
      class="google-image-retention"
      aria-labelledby="google-image-retention-title"
    >
      <div class="google-image-retention-shell">
        <div class="google-image-retention-copy">
          <p class="google-image-retention-kicker">{content.copy.kicker}</p>
          <h2 id="google-image-retention-title">{content.title}</h2>
          <p>{content.body}</p>
          <div class="google-image-retention-actions">
            <a class="google-image-retention-primary" href={tryOnHref}>
              {content.copy.primaryLabel}
            </a>
            <a class="google-image-retention-secondary" href={pricingHref}>
              {content.copy.secondaryLabel}
            </a>
          </div>
        </div>

        <aside class="google-image-retention-decision">
          <span>{content.copy.decisionLabel}</span>
          <strong>{content.copy.decisionTitle}</strong>
          <p>{content.decisionBody}</p>
          <ul aria-label={content.copy.decisionTitle}>
            {content.copy.proofPoints.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </aside>
      </div>

      <a class="google-image-retention-sticky" href={tryOnHref}>
        {content.copy.stickyLabel}
      </a>
    </section>
  )
}

<style>
  .google-image-retention {
    width: min(calc(100% - 3rem), 1120px);
    margin: 1.25rem auto 0;
  }

  .google-image-retention-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
    gap: 1rem;
    align-items: stretch;
  }

  .google-image-retention-copy,
  .google-image-retention-decision {
    border: 1px solid var(--warm-border);
    border-radius: 8px;
    background: var(--bg-elevated);
    box-shadow: 0 16px 36px rgba(53, 43, 38, 0.07);
  }

  .google-image-retention-copy {
    padding: clamp(1.1rem, 2.5vw, 1.65rem);
  }

  .google-image-retention-kicker {
    margin: 0 0 0.55rem;
    color: var(--rose-dark);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .google-image-retention h2 {
    margin: 0 0 0.65rem;
    color: var(--heading);
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3vw, 2.15rem);
    line-height: 1.12;
    overflow-wrap: anywhere;
  }

  .google-image-retention-copy > p,
  .google-image-retention-decision p {
    margin: 0;
    color: var(--body-secondary);
    line-height: 1.58;
  }

  .google-image-retention-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1rem;
  }

  .google-image-retention-primary,
  .google-image-retention-secondary,
  .google-image-retention-sticky {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
    transition:
      transform 0.16s ease,
      background 0.16s ease,
      box-shadow 0.16s ease;
  }

  .google-image-retention-primary,
  .google-image-retention-sticky {
    border: 1px solid var(--rose-dark);
    background: linear-gradient(135deg, #c83e68, #9f294f);
    color: #fff;
    box-shadow: var(--btn-primary-shadow);
  }

  .google-image-retention-primary {
    padding: 0.72rem 1.2rem;
  }

  .google-image-retention-secondary {
    border: 1px solid var(--warm-border);
    background: var(--surface-warm);
    color: var(--heading);
    padding: 0.72rem 1rem;
  }

  .google-image-retention-primary:hover,
  .google-image-retention-secondary:hover,
  .google-image-retention-sticky:hover {
    transform: translateY(-1px);
  }

  .google-image-retention-primary:active,
  .google-image-retention-secondary:active,
  .google-image-retention-sticky:active {
    transform: translateY(1px);
  }

  .google-image-retention-decision {
    display: grid;
    align-content: center;
    gap: 0.4rem;
    padding: clamp(1rem, 2.5vw, 1.4rem);
    background:
      linear-gradient(135deg, rgba(255, 245, 247, 0.9), transparent 58%),
      var(--bg-elevated);
  }

  .google-image-retention-decision span {
    color: var(--rose-dark);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .google-image-retention-decision strong {
    color: var(--heading);
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .google-image-retention-decision ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0;
    margin: 0.65rem 0 0;
    list-style: none;
  }

  .google-image-retention-decision li {
    border: 1px solid rgba(200, 62, 104, 0.22);
    border-radius: 999px;
    padding: 0.35rem 0.6rem;
    background: rgba(255, 245, 247, 0.86);
    color: var(--heading);
    font-size: 0.78rem;
    font-weight: 750;
  }

  .google-image-retention-sticky {
    display: none;
  }

  @media (max-width: 820px) {
    .google-image-retention {
      width: min(calc(100% - 2rem), 620px);
    }

    .google-image-retention-shell {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .google-image-retention {
      width: min(calc(100% - 1.5rem), 420px);
      margin-top: 0.85rem;
    }

    .google-image-retention-copy,
    .google-image-retention-decision {
      padding: 1rem;
    }

    .google-image-retention-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .google-image-retention-primary,
    .google-image-retention-secondary {
      width: 100%;
    }

    .google-image-retention-sticky {
      position: sticky;
      bottom: 0.75rem;
      z-index: 5;
      display: flex;
      width: 100%;
      margin-top: 0.9rem;
      padding: 0.72rem 1rem;
    }
  }

  @media (prefers-color-scheme: dark) {
    .google-image-retention-decision {
      background:
        linear-gradient(135deg, rgba(200, 62, 104, 0.14), transparent 58%),
        var(--bg-elevated);
    }

    .google-image-retention-secondary {
      background: rgba(24, 28, 34, 0.9);
    }

    .google-image-retention-decision li {
      background: rgba(200, 62, 104, 0.16);
    }
  }
</style>
