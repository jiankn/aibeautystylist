---
interface Props {
  mode: "blush-placement" | "lip-finish";
  kicker: string;
  title: string;
  body: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
  proofPoints: readonly string[];
  membershipTitle: string;
  membershipBody: string;
}

const {
  mode,
  kicker,
  title,
  body,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
  proofPoints,
  membershipTitle,
  membershipBody,
} = Astro.props;
---

<section class:list={["pin-experiment", `pin-experiment-${mode}`]}>
  <div class="pin-experiment-main">
    <div class="pin-experiment-copy">
      <p class="pin-experiment-kicker">{kicker}</p>
      <h2>{title}</h2>
      <p>{body}</p>

      <div class="pin-experiment-actions">
        <a class="pin-experiment-primary" href={primaryHref}>{primaryLabel}</a>
        <a class="pin-experiment-secondary" href={secondaryHref}
          >{secondaryLabel}</a
        >
      </div>

      <ul class="pin-experiment-proof" aria-label="Preview details">
        {proofPoints.map((point) => <li>{point}</li>)}
      </ul>
    </div>

    {
      mode === "blush-placement" ? (
        <div
          class="pin-experiment-visual blush-placement-guide"
          aria-label="Blush placement guide"
        >
          <p>Choose the effect</p>
          <div class="blush-placement-grid">
            <article>
              <svg viewBox="0 0 120 142" aria-hidden="true">
                <ellipse cx="60" cy="68" rx="42" ry="55" class="face-base" />
                <path d="M37 56q9-6 17 0M67 56q9-6 17 0" class="face-line" />
                <path d="M60 60l-4 16h8M47 89q13 10 26 0" class="face-line" />
                <ellipse
                  cx="80"
                  cy="73"
                  rx="24"
                  ry="10"
                  transform="rotate(-28 80 73)"
                  class="blush-mark"
                />
                <path d="M88 64l19-18m-1 0h-9m9 0v9" class="blush-arrow" />
              </svg>
              <h3>Lift</h3>
              <p>Sweep high toward the temples.</p>
            </article>

            <article>
              <svg viewBox="0 0 120 142" aria-hidden="true">
                <ellipse cx="60" cy="68" rx="42" ry="55" class="face-base" />
                <path d="M37 56q9-6 17 0M67 56q9-6 17 0" class="face-line" />
                <path d="M60 60l-4 16h8M47 89q13 10 26 0" class="face-line" />
                <ellipse cx="35" cy="78" rx="20" ry="14" class="blush-mark" />
                <ellipse cx="85" cy="78" rx="20" ry="14" class="blush-mark" />
              </svg>
              <h3>Soften</h3>
              <p>Blend across the apples.</p>
            </article>

            <article>
              <svg viewBox="0 0 120 142" aria-hidden="true">
                <ellipse cx="60" cy="68" rx="42" ry="55" class="face-base" />
                <path d="M37 56q9-6 17 0M67 56q9-6 17 0" class="face-line" />
                <path d="M60 60l-4 16h8M47 89q13 10 26 0" class="face-line" />
                <ellipse
                  cx="37"
                  cy="67"
                  rx="21"
                  ry="8"
                  transform="rotate(10 37 67)"
                  class="blush-mark"
                />
                <ellipse
                  cx="83"
                  cy="67"
                  rx="21"
                  ry="8"
                  transform="rotate(-10 83 67)"
                  class="blush-mark"
                />
              </svg>
              <h3>Freshen</h3>
              <p>Tap high under the eyes.</p>
            </article>
          </div>
          <strong>Watercolor Blush opens already selected.</strong>
        </div>
      ) : (
        <div
          class="pin-experiment-visual lip-finish-guide"
          aria-label="Jelly lip tint finish guide"
        >
          <p>Judge the finish in daylight</p>
          <div class="lip-finish-swatches" aria-hidden="true">
            <span class="lip-swatch lip-swatch-sheer" />
            <span class="lip-swatch lip-swatch-glossy" />
            <span class="lip-swatch lip-swatch-stain" />
          </div>
          <div class="lip-finish-labels">
            <article>
              <h3>Sheer color</h3>
              <p>The natural lip still shows through.</p>
            </article>
            <article>
              <h3>Glassy surface</h3>
              <p>Hydration without plastic shine.</p>
            </article>
            <article>
              <h3>Soft stain</h3>
              <p>Color remains after the gloss settles.</p>
            </article>
          </div>
          <strong>Jelly Lip Tint opens already selected.</strong>
        </div>
      )
    }
  </div>

  <div class="pin-experiment-membership">
    <div>
      <h3>{membershipTitle}</h3>
      <p>{membershipBody}</p>
    </div>
    <a href={secondaryHref}>{secondaryLabel}</a>
  </div>
</section>

<style>
  .pin-experiment {
    width: min(calc(100% - 3rem), 1120px);
    margin: 2.5rem auto;
  }

  .pin-experiment-main {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(360px, 1.08fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .pin-experiment-copy,
  .pin-experiment-visual {
    border: 1px solid var(--warm-border);
    border-radius: 8px;
    background: var(--bg-elevated);
    box-shadow: 0 18px 42px rgba(53, 43, 38, 0.08);
  }

  .pin-experiment-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.4rem, 3vw, 2.4rem);
  }

  .pin-experiment-kicker {
    margin: 0 0 0.7rem;
    color: var(--rose-dark);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .pin-experiment-copy h2 {
    max-width: 13ch;
    margin: 0 0 0.85rem;
    color: var(--heading);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.08;
  }

  .pin-experiment-copy > p {
    margin: 0;
    color: var(--body-secondary);
    line-height: 1.65;
  }

  .pin-experiment-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.35rem;
  }

  .pin-experiment-actions a,
  .pin-experiment-membership a {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    padding: 0.75rem 1.1rem;
    font-weight: 800;
    text-align: center;
    text-decoration: none;
  }

  .pin-experiment-primary {
    border: 1px solid var(--rose-dark);
    background: var(--rose);
    color: #fff;
    box-shadow: var(--btn-primary-shadow);
  }

  .pin-experiment-secondary,
  .pin-experiment-membership a {
    border: 1px solid var(--warm-border);
    background: var(--bg-elevated);
    color: var(--heading);
  }

  .pin-experiment-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 1.1rem 0 0;
    list-style: none;
  }

  .pin-experiment-proof li {
    border: 1px solid rgba(200, 62, 104, 0.22);
    border-radius: 999px;
    padding: 0.4rem 0.65rem;
    background: var(--surface-rose);
    color: var(--heading);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .pin-experiment-visual {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .pin-experiment-visual > p {
    margin: 0 0 1.25rem;
    color: var(--body-secondary);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .blush-placement-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
  }

  .blush-placement-grid article {
    min-width: 0;
    padding: 0 0.8rem 0.9rem;
    text-align: center;
  }

  .blush-placement-grid article + article {
    border-left: 1px solid var(--warm-border);
  }

  .blush-placement-grid svg {
    width: min(100%, 128px);
    height: auto;
  }

  .face-base {
    fill: #f8dfd3;
    stroke: #be8a7e;
    stroke-width: 2;
  }

  .face-line {
    fill: none;
    stroke: #765452;
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .blush-mark {
    fill: #df6c7a;
    opacity: 0.55;
  }

  .blush-arrow {
    fill: none;
    stroke: #c95161;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pin-experiment-visual h3 {
    margin: 0 0 0.35rem;
    color: var(--heading);
    font-size: 1rem;
  }

  .pin-experiment-visual article p {
    margin: 0;
    color: var(--body-secondary);
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .pin-experiment-visual > strong {
    display: block;
    margin-top: 1.1rem;
    border-top: 1px solid var(--warm-border);
    padding-top: 1rem;
    color: var(--heading);
    font-size: 0.9rem;
    text-align: center;
  }

  .lip-finish-guide {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .lip-finish-swatches {
    display: grid;
    grid-template-columns: repeat(3, 76px);
    gap: clamp(1rem, 3vw, 2rem);
    justify-content: center;
    margin: 0.5rem 0 1.5rem;
  }

  .lip-swatch {
    width: 76px;
    height: 76px;
    border: 8px solid rgba(255, 255, 255, 0.78);
    border-radius: 50%;
    box-shadow:
      0 0 0 1px rgba(88, 47, 55, 0.14),
      0 8px 22px rgba(88, 47, 55, 0.12);
  }

  .lip-swatch-sheer {
    background: #d98991;
  }

  .lip-swatch-glossy {
    background: #ad405d;
  }

  .lip-swatch-stain {
    background: #7c2f4c;
  }

  .lip-finish-labels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .lip-finish-labels article {
    padding: 0 0.85rem;
    text-align: center;
  }

  .lip-finish-labels article + article {
    border-left: 1px solid var(--warm-border);
  }

  .pin-experiment-membership {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.25rem;
    border-top: 1px solid var(--warm-border);
    padding: 1.25rem 0;
  }

  .pin-experiment-membership h3 {
    margin: 0 0 0.35rem;
    color: var(--heading);
    font-family: var(--font-display);
    font-size: 1.2rem;
  }

  .pin-experiment-membership p {
    max-width: 700px;
    margin: 0;
    color: var(--body-secondary);
    line-height: 1.55;
  }

  .pin-experiment-membership a {
    flex: 0 0 auto;
  }

  @media (max-width: 820px) {
    .pin-experiment {
      width: min(calc(100% - 2rem), 620px);
    }

    .pin-experiment-main {
      grid-template-columns: 1fr;
    }

    .pin-experiment-copy h2 {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .pin-experiment {
      margin: 1.5rem auto;
    }

    .pin-experiment-actions a {
      width: 100%;
    }

    .blush-placement-grid {
      grid-template-columns: 1fr;
    }

    .blush-placement-grid article {
      display: grid;
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 0 1rem;
      align-items: center;
      text-align: left;
    }

    .blush-placement-grid article + article {
      border-top: 1px solid var(--warm-border);
      border-left: 0;
      padding-top: 0.9rem;
    }

    .blush-placement-grid svg {
      grid-row: span 2;
    }

    .lip-finish-swatches {
      grid-template-columns: repeat(3, 62px);
      gap: 1rem;
    }

    .lip-swatch {
      width: 62px;
      height: 62px;
    }

    .lip-finish-labels {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .lip-finish-labels article {
      text-align: left;
    }

    .lip-finish-labels article + article {
      border-top: 1px solid var(--warm-border);
      border-left: 0;
      padding-top: 0.85rem;
    }

    .pin-experiment-membership {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
