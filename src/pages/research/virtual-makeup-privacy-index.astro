---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import {
  privacyIndexChecks,
  privacyIndexEntries,
  researchContextSources,
  virtualMakeupPrivacyIndexCsvPath,
  virtualMakeupPrivacyIndexReviewedAt,
  virtualMakeupPrivacyIndexVersion,
} from "../../data/virtualMakeupPrivacyIndex";
import type { PrivacyDisclosureStatus } from "../../data/virtualMakeupPrivacyIndex";

const title = "Virtual Makeup Privacy Index 2026 | AI Beauty Stylist";
const description =
  "A policy-based transparency review of beauty AI and virtual makeup tools, covering photo retention, face data, deletion paths, AI training disclosures, and third-party processing.";
const pageUrl = new URL(
  "/research/virtual-makeup-privacy-index",
  Astro.site ?? Astro.url.origin,
).href;
const csvUrl = new URL(
  virtualMakeupPrivacyIndexCsvPath,
  Astro.site ?? Astro.url.origin,
).href;
const perfectScoreCount = privacyIndexEntries.filter(
  (entry) => entry.score === privacyIndexChecks.length,
).length;
const partialDisclosureCount = privacyIndexEntries.length - perfectScoreCount;
const sortedEntries = [...privacyIndexEntries].sort(
  (a, b) => b.score - a.score || a.service.localeCompare(b.service),
);
const disclosureFields = [
  {
    key: "photoFaceData",
    shortLabel: "Data",
    label: "Photo or face data",
    check: privacyIndexChecks[0],
  },
  {
    key: "retention",
    shortLabel: "Retention",
    label: "Retention timing",
    check: privacyIndexChecks[1],
  },
  {
    key: "deletion",
    shortLabel: "Deletion",
    label: "Deletion path",
    check: privacyIndexChecks[2],
  },
  {
    key: "aiTraining",
    shortLabel: "AI use",
    label: "AI training or improvement",
    check: privacyIndexChecks[3],
  },
  {
    key: "thirdParties",
    shortLabel: "Third parties",
    label: "Third-party processing",
    check: privacyIndexChecks[4],
  },
] as const;
const disclosureCoverage = disclosureFields.map((field) => ({
  ...field,
  disclosed: privacyIndexEntries.filter(
    (entry) => entry[field.key] === "Disclosed",
  ).length,
}));
const contextPublisherCount = new Set(
  researchContextSources.map((source) => source.publisher),
).size;
const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "Virtual Makeup Privacy Index 2026",
    description,
    url: pageUrl,
    version: virtualMakeupPrivacyIndexVersion,
    datePublished: virtualMakeupPrivacyIndexReviewedAt,
    dateModified: virtualMakeupPrivacyIndexReviewedAt,
    creator: {
      "@type": "Organization",
      name: "AI Beauty Stylist",
      url: "https://aibeautystylist.com",
    },
    measurementTechnique: privacyIndexChecks.join("; "),
    distribution: {
      "@type": "DataDownload",
      encodingFormat: "text/csv",
      contentUrl: csvUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Virtual Makeup Privacy Index 2026",
    description,
    datePublished: virtualMakeupPrivacyIndexReviewedAt,
    dateModified: virtualMakeupPrivacyIndexReviewedAt,
    author: {
      "@type": "Organization",
      name: "AI Beauty Stylist",
      url: "https://aibeautystylist.com",
    },
    mainEntityOfPage: pageUrl,
  },
]);

const scoreBandLabel = (score: number) =>
  score === privacyIndexChecks.length ? "Complete" : "Needs review";
const scoreBandClass = (score: number) =>
  score === privacyIndexChecks.length ? "score-complete" : "score-review";
const disclosureClass = (status: PrivacyDisclosureStatus) =>
  status === "Disclosed"
    ? "is-disclosed"
    : status === "Not applicable"
      ? "is-neutral"
      : "is-unstated";
const disclosureShort = (status: PrivacyDisclosureStatus) =>
  status === "Disclosed"
    ? "Yes"
    : status === "Not applicable"
      ? "N/A"
      : "Not stated";
const sourceLabel = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return "Source";
  }
};
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  jsonLd={jsonLd}
>
  <SiteHeader active="blog" />
  <main class="privacy-index-main">
    <section class="report-hero shell" aria-labelledby="index-title">
      <div class="hero-copy">
        <span class="report-label">AI Beauty Stylist Research</span>
        <h1 id="index-title">Virtual Makeup Privacy Index 2026</h1>
        <p>
          A source-linked review of how beauty AI tools disclose photo, face
          data, retention, deletion, AI use, and vendors.
        </p>
        <div class="hero-actions" aria-label="Report actions">
          <a class="btn btn-primary" href={virtualMakeupPrivacyIndexCsvPath}
            >Download CSV</a
          >
          <a class="btn" href="#methodology">Read methodology</a>
        </div>
      </div>
      <aside class="report-card" aria-label="Report status">
        <div class="report-card-top">
          <span>Report status</span>
          <strong>Reviewed</strong>
        </div>
        <dl class="report-meta">
          <div>
            <dt>Review date</dt>
            <dd>
              <time datetime={virtualMakeupPrivacyIndexReviewedAt}>
                {virtualMakeupPrivacyIndexReviewedAt}
              </time>
            </dd>
          </div>
          <div>
            <dt>Version</dt>
            <dd>{virtualMakeupPrivacyIndexVersion}</dd>
          </div>
          <div>
            <dt>Dataset</dt>
            <dd>
              <a href={virtualMakeupPrivacyIndexCsvPath}>CSV file</a>
            </dd>
          </div>
        </dl>
        <div class="score-summary" aria-label="Index summary">
          <div>
            <strong>{privacyIndexEntries.length}</strong>
            <span>tools reviewed</span>
          </div>
          <div>
            <strong>{privacyIndexChecks.length}</strong>
            <span>policy checks</span>
          </div>
          <div>
            <strong>{perfectScoreCount}</strong>
            <span>complete profiles</span>
          </div>
        </div>
      </aside>
    </section>

    <section class="executive-brief shell" aria-labelledby="summary-title">
      <div class="brief-copy">
        <span class="section-note">Executive summary</span>
        <h2 id="summary-title">What editors can take from this report</h2>
        <p>
          This index measures public privacy transparency. It does not inspect
          backend systems, verify every deployment, or rank product quality. The
          useful signal is whether a reader can find clear answers before
          uploading a face photo.
        </p>
      </div>
      <div class="brief-grid">
        <article class="brief-item large">
          <b>{perfectScoreCount} of {privacyIndexEntries.length}</b>
          <span>
            profiles clearly disclose all five policy topics reviewed for this
            index.
          </span>
        </article>
        <article class="brief-item">
          <b>{partialDisclosureCount}</b>
          <span
            >profile needs closer review on at least one disclosure area.</span
          >
        </article>
        <article class="brief-item">
          <b>{contextPublisherCount}</b>
          <span
            >external context sources are cited for the market backdrop.</span
          >
        </article>
      </div>
    </section>

    <section class="research-section shell" aria-labelledby="findings-title">
      <div class="report-section-heading">
        <h2 id="findings-title">Key findings</h2>
        <p>
          The pattern is not simply "private" or "not private." Public notices
          vary in the exact promises they make about processing location,
          retention windows, model improvement, and vendor routing.
        </p>
      </div>
      <div class="finding-layout">
        <article class="finding-primary">
          <h3>Retention language is the strongest public signal.</h3>
          <p>
            The most useful policies state whether virtual try-on happens on
            device, whether uploaded media is deleted after the task, or whether
            server logs keep image data for a defined period.
          </p>
        </article>
        <div class="finding-stack">
          <article>
            <h3>AI use needs exact wording.</h3>
            <p>
              Model training, internal research, service improvement, and
              generative AI retention are different claims. The table keeps
              those distinctions visible.
            </p>
          </article>
          <article>
            <h3>SDK privacy is not the full deployment story.</h3>
            <p>
              A privacy-preserving SDK can be embedded inside a merchant flow
              that adds account data, analytics, or separate vendor processing.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="research-section shell" aria-labelledby="coverage-title">
      <div class="report-section-heading">
        <h2 id="coverage-title">Disclosure coverage</h2>
        <p>
          Each check below counts how many reviewed profiles clearly disclosed
          that topic in public materials on the review date.
        </p>
      </div>
      <div class="coverage-grid">
        {
          disclosureCoverage.map((field) => (
            <article>
              <div>
                <b>
                  {field.disclosed}/{privacyIndexEntries.length}
                </b>
                <span>{field.shortLabel}</span>
              </div>
              <p>{field.check}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="research-section shell" aria-labelledby="matrix-title">
      <div class="report-section-heading">
        <h2 id="matrix-title">Disclosure matrix</h2>
        <p>
          The matrix is a compact reading aid for outreach and citation. The
          full notes and source links remain in the score table.
        </p>
      </div>
      <div class="matrix-legend" aria-label="Matrix legend">
        <span class="legend-cell is-disclosed">Yes</span>
        <span class="legend-cell is-unstated">Not stated</span>
        <span class="legend-cell is-neutral">N/A</span>
      </div>
      <div class="matrix-table" role="table" aria-label="Disclosure matrix">
        <div class="matrix-row matrix-head" role="row">
          <span role="columnheader">Tool</span>
          {
            disclosureFields.map((field) => (
              <span role="columnheader">{field.shortLabel}</span>
            ))
          }
        </div>
        {
          sortedEntries.map((entry) => (
            <div class="matrix-row" role="row">
              <strong role="rowheader">{entry.service}</strong>
              {disclosureFields.map((field) => (
                <span
                  class:list={[
                    "matrix-cell",
                    disclosureClass(entry[field.key]),
                  ]}
                  role="cell"
                  aria-label={`${field.label}: ${entry[field.key]}`}
                >
                  {disclosureShort(entry[field.key])}
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <section class="research-section shell" id="methodology">
      <div class="methodology-layout">
        <div class="report-section-heading">
          <h2>Methodology and limits</h2>
          <p>
            We reviewed public privacy policies, AI terms, biometric sections,
            and help-center statements available on the review date. Each clear
            observable disclosure is worth one point.
          </p>
        </div>
        <aside class="method-note">
          <b>Important limit</b>
          <p>
            "Not stated" means the public wording reviewed for this index did
            not clearly answer the question. It is not a finding about hidden
            systems or actual legal compliance.
          </p>
        </aside>
      </div>
      <ol class="method-list">
        {
          privacyIndexChecks.map((check) => (
            <li>
              <span>{check}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="research-section shell" aria-labelledby="score-table-title">
      <div class="table-header">
        <div class="report-section-heading">
          <h2 id="score-table-title">Score table</h2>
          <p>
            Scores reflect whether each policy topic is clearly disclosed in
            public materials reviewed on {virtualMakeupPrivacyIndexReviewedAt}.
          </p>
        </div>
        <a class="btn btn-outline" href={virtualMakeupPrivacyIndexCsvPath}
          >CSV dataset</a
        >
      </div>
      <div class="table-wrap" tabindex="0" aria-label="Scrollable score table">
        <table>
          <caption>
            Virtual makeup privacy transparency scores and source notes.
          </caption>
          <thead>
            <tr>
              <th scope="col">Tool and notes</th>
              <th scope="col">Score</th>
              {
                disclosureFields.map((field) => (
                  <th scope="col">{field.shortLabel}</th>
                ))
              }
              <th scope="col">Retention detail</th>
              <th scope="col">Sources</th>
            </tr>
          </thead>
          <tbody>
            {
              sortedEntries.map((entry) => (
                <tr>
                  <th scope="row" class="service-cell">
                    <strong>{entry.service}</strong>
                    <span>
                      {entry.vendor} | {entry.category}
                    </span>
                    <em>{entry.notes}</em>
                  </th>
                  <td>
                    <span
                      class:list={["score-pill", scoreBandClass(entry.score)]}
                      aria-label={`${entry.service} score ${entry.score} of ${privacyIndexChecks.length}`}
                    >
                      {entry.score}/{privacyIndexChecks.length}
                      <small>{scoreBandLabel(entry.score)}</small>
                    </span>
                  </td>
                  {disclosureFields.map((field) => (
                    <td>
                      <span
                        class:list={[
                          "status-chip",
                          disclosureClass(entry[field.key]),
                        ]}
                      >
                        {disclosureShort(entry[field.key])}
                      </span>
                    </td>
                  ))}
                  <td>{entry.notableRetention}</td>
                  <td class="source-cell">
                    <a
                      href={entry.sourceUrl}
                      rel="nofollow noopener"
                      target="_blank"
                    >
                      {sourceLabel(entry.sourceUrl)}
                    </a>
                    {entry.secondarySourceUrl ? (
                      <a
                        href={entry.secondarySourceUrl}
                        rel="nofollow noopener"
                        target="_blank"
                      >
                        {sourceLabel(entry.secondarySourceUrl)}
                      </a>
                    ) : null}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="mobile-index-list" aria-label="Mobile score cards">
        {
          sortedEntries.map((entry) => (
            <article>
              <div class="mobile-card-head">
                <h3>{entry.service}</h3>
                <span class:list={["score-pill", scoreBandClass(entry.score)]}>
                  {entry.score}/{privacyIndexChecks.length}
                </span>
              </div>
              <p>{entry.notes}</p>
              <dl>
                {disclosureFields.map((field) => (
                  <div>
                    <dt>{field.shortLabel}</dt>
                    <dd
                      class:list={[
                        "status-chip",
                        disclosureClass(entry[field.key]),
                      ]}
                    >
                      {disclosureShort(entry[field.key])}
                    </dd>
                  </div>
                ))}
              </dl>
              <div class="mobile-retention">
                <b>Retention detail</b>
                <span>{entry.notableRetention}</span>
              </div>
              <div class="source-cell">
                <a
                  href={entry.sourceUrl}
                  rel="nofollow noopener"
                  target="_blank"
                >
                  {sourceLabel(entry.sourceUrl)}
                </a>
                {entry.secondarySourceUrl ? (
                  <a
                    href={entry.secondarySourceUrl}
                    rel="nofollow noopener"
                    target="_blank"
                  >
                    {sourceLabel(entry.secondarySourceUrl)}
                  </a>
                ) : null}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="research-section shell" aria-labelledby="context-title">
      <div class="context-layout">
        <div class="report-section-heading">
          <h2 id="context-title">Market context</h2>
          <p>
            These outside sources explain why virtual try-on privacy, biometric
            consent, and AI photo handling are active editorial topics.
          </p>
        </div>
        <div class="context-list">
          {
            researchContextSources.map((source) => (
              <a href={source.url} rel="nofollow noopener" target="_blank">
                <strong>{source.title}</strong>
                <span>{source.publisher}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="citation-band">
      <div class="shell citation-layout">
        <div>
          <span class="section-note">Citation and corrections</span>
          <h2>How to cite this index</h2>
          <p>
            AI Beauty Stylist, "Virtual Makeup Privacy Index 2026," version {
              virtualMakeupPrivacyIndexVersion
            }, reviewed {virtualMakeupPrivacyIndexReviewedAt}. For changed
            policies or source corrections, contact support with the updated
            public URL.
          </p>
        </div>
        <div class="citation-actions">
          <a class="btn btn-primary" href={virtualMakeupPrivacyIndexCsvPath}
            >Download CSV</a
          >
          <a class="btn" href="/support">Request correction</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .privacy-index-main {
    --report-surface: color-mix(
      in srgb,
      var(--page-surface) 78%,
      var(--bg-elevated)
    );
    --report-panel: var(--bg-elevated);
    --report-tint: color-mix(in srgb, var(--surface-rose) 72%, var(--soft));
    --report-accent: var(--rose);
    --report-rule: color-mix(in srgb, var(--line) 84%, transparent);
    background:
      linear-gradient(180deg, var(--report-tint) 0, transparent 440px),
      var(--report-surface);
    color: var(--text);
  }

  .report-hero {
    display: grid;
    min-height: min(720px, calc(100dvh - 62px));
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 400px);
    gap: clamp(26px, 4vw, 58px);
    align-items: center;
    padding-top: 50px;
    padding-bottom: 42px;
  }

  .report-label,
  .section-note {
    display: block;
    color: var(--report-accent);
    font-size: 13px;
    font-weight: 780;
    letter-spacing: 0;
  }

  .hero-copy {
    max-width: 840px;
  }

  .hero-copy h1 {
    max-width: 820px;
    margin: 14px 0 0;
    color: var(--heading);
    font-family: var(--font-display);
    font-size: clamp(42px, 5vw, 66px);
    font-weight: 560;
    line-height: 1.04;
    letter-spacing: 0;
  }

  .hero-copy p {
    max-width: 660px;
    margin: 24px 0 0;
    color: var(--body-secondary);
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.7;
  }

  .hero-actions,
  .citation-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-actions {
    margin-top: 30px;
  }

  .report-card,
  .brief-item,
  .finding-primary,
  .finding-stack article,
  .coverage-grid article,
  .method-note,
  .method-list li,
  .table-wrap,
  .mobile-index-list article,
  .context-list a {
    border: 1px solid var(--report-rule);
    border-radius: 8px;
    background: var(--report-panel);
    box-shadow: var(--btn-shadow);
  }

  .report-card {
    display: grid;
    gap: 20px;
    padding: clamp(20px, 3vw, 28px);
  }

  .report-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--report-rule);
  }

  .report-card-top span,
  .report-meta dt,
  .score-summary span,
  .brief-item span,
  .coverage-grid span,
  .context-list span {
    color: var(--muted);
    font-size: 12px;
    font-weight: 720;
    line-height: 1.45;
  }

  .report-card-top strong {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    border: 1px solid var(--success-border);
    border-radius: 999px;
    background: var(--surface-success);
    color: var(--success-text);
    padding: 0 12px;
    font-size: 12px;
  }

  .report-meta {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  .report-meta div {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
  }

  .report-meta dd {
    margin: 0;
    color: var(--heading);
    font-size: 14px;
    font-weight: 760;
  }

  .report-meta a,
  .source-cell a,
  .context-list a {
    color: var(--report-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .score-summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    padding-top: 18px;
    border-top: 1px solid var(--report-rule);
  }

  .score-summary strong {
    display: block;
    color: var(--heading);
    font-size: clamp(26px, 4vw, 40px);
    line-height: 1;
  }

  .score-summary span {
    display: block;
    margin-top: 8px;
  }

  .executive-brief {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 0.76fr);
    gap: clamp(24px, 5vw, 60px);
    align-items: start;
    padding-top: 30px;
    padding-bottom: 56px;
  }

  .brief-copy h2,
  .report-section-heading h2,
  .citation-layout h2 {
    margin: 10px 0 0;
    color: var(--heading);
    font-size: clamp(28px, 3.2vw, 42px);
    line-height: 1.16;
    letter-spacing: 0;
  }

  .brief-copy p,
  .report-section-heading p,
  .citation-layout p {
    max-width: 760px;
    margin: 16px 0 0;
    color: var(--body-secondary);
    font-size: 15px;
    line-height: 1.78;
  }

  .brief-grid {
    display: grid;
    grid-template-columns: 1fr 0.82fr;
    gap: 12px;
  }

  .brief-item {
    display: grid;
    min-height: 150px;
    align-content: space-between;
    gap: 20px;
    padding: 20px;
  }

  .brief-item.large {
    grid-row: span 2;
    background:
      linear-gradient(135deg, transparent, var(--report-tint)),
      var(--report-panel);
  }

  .brief-item b {
    color: var(--heading);
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1.05;
  }

  .brief-item span {
    color: var(--body-secondary);
    font-size: 13px;
    font-weight: 620;
  }

  .research-section {
    padding-top: 70px;
    padding-bottom: 10px;
  }

  .report-section-heading {
    max-width: 850px;
  }

  .finding-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.78fr);
    gap: 14px;
    margin-top: 30px;
  }

  .finding-primary {
    min-height: 300px;
    padding: clamp(24px, 4vw, 38px);
    background:
      linear-gradient(135deg, var(--report-tint), transparent 65%),
      var(--report-panel);
  }

  .finding-stack {
    display: grid;
    gap: 14px;
  }

  .finding-stack article {
    min-height: 142px;
    padding: 22px;
  }

  .finding-primary h3,
  .finding-stack h3,
  .mobile-index-list h3 {
    margin: 0;
    color: var(--heading);
    font-size: clamp(18px, 2vw, 25px);
    line-height: 1.28;
  }

  .finding-primary p,
  .finding-stack p,
  .coverage-grid p,
  .method-note p,
  .mobile-index-list p,
  .mobile-retention span {
    margin: 14px 0 0;
    color: var(--body-secondary);
    font-size: 13px;
    line-height: 1.72;
  }

  .finding-primary p {
    max-width: 640px;
    font-size: 15px;
  }

  .coverage-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    margin-top: 30px;
  }

  .coverage-grid article {
    display: grid;
    min-height: 170px;
    align-content: space-between;
    gap: 18px;
    padding: 18px;
  }

