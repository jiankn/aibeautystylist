---
import PinterestExperimentPanel from "../../components/PinterestExperimentPanel.astro";
import SeoLandingLayout from "../../components/SeoLandingLayout.astro";
import { getLocalizedAppHref, resolveLocaleRoute } from "../../i18n/routing";

const page = {
  title: "Blush Placement Map: Lift, Soften, or Freshen Your Face",
  description:
    "Compare three blush placement directions, understand how each changes the face, and preview watercolor blush on your own selfie free.",
  faq: [
    {
      q: "Where should blush go for a lifted look?",
      a: "Keep the color above the hollow of the cheek and blend it toward the temple. The upward angle visually lengthens the cheek and keeps the center of the face open.",
    },
    {
      q: "Where should blush go for a softer face?",
      a: "Place a restrained amount across the apples of the cheeks and diffuse the edges. A wider horizontal placement softens angular features without pulling the face downward.",
    },
    {
      q: "What is under-eye blush placement?",
      a: "Under-eye placement uses a light wash high on the cheek, close to the lower eye area. It creates a fresh, youthful flush, but the color should stay sheer so it does not emphasize texture.",
    },
  ],
};

const currentPathname = Astro.originPathname || Astro.url.pathname;
const currentRoute =
  Astro.locals.localeRoute ?? resolveLocaleRoute(currentPathname);
const localizeAppHref = (href: string) =>
  getLocalizedAppHref(href, currentRoute.language.slug);
const isEastAsianLocale = /^(zh|ja|ko)/i.test(currentRoute.language.locale);
const pinterestSource =
  Astro.url.searchParams.get("utm_source") === "pinterest";
const googleImageSource =
  Astro.url.searchParams.get("utm_source") === "google_images" ||
  (Astro.url.searchParams.get("source")?.startsWith("google_image") ?? false);
const incomingUtmContent = Astro.url.searchParams.get("utm_content");

const heroImage = isEastAsianLocale
  ? "/images/look-card/looks/watercolor-blush--east-asia-640.webp"
  : "/images/pinterest/blush-placement-map.webp";
const pinVisual = isEastAsianLocale
  ? "watercolor_blush_east_asia"
  : "blush_placement_map";
const marketProfile = isEastAsianLocale ? "east-asia" : "global-diverse";
const attribution = pinterestSource
  ? {
      source: "pinterest_blush_placement",
      utmSource: "pinterest",
      utmMedium: "organic_social",
      utmCampaign: "launch",
      utmContent: incomingUtmContent?.startsWith("pin_blush_placement")
        ? incomingUtmContent
        : "pin_blush_placement_map_01",
    }
  : googleImageSource
    ? {
        source: "google_images_blush_placement",
        utmSource: "google_images",
        utmMedium: "organic_search",
        utmCampaign: "image_retention",
        utmContent: "google_image_blush_placement_01",
      }
    : {
        source: "blush_placement_page",
        utmSource: "onsite",
        utmMedium: "seo_landing",
        utmCampaign: "blush_placement",
        utmContent: "blush_placement_hero",
      };

const tryonParams = new URLSearchParams({
  look: "watercolor-blush",
  marketProfile,
  guest_try: pinterestSource || googleImageSource ? "1" : "0",
  source: attribution.source,
  pin_visual: pinVisual,
  utm_source: attribution.utmSource,
  utm_medium: attribution.utmMedium,
  utm_campaign: attribution.utmCampaign,
  utm_content: attribution.utmContent,
});
const tryonHref = localizeAppHref(
  `/tryon?${tryonParams.toString()}#tryon-upload`,
);
const pricingHref = localizeAppHref(
  "/pricing?source=pinterest_blush_placement",
);
const heroBody = pinterestSource
  ? "You saved the placement map. Now preview the same watercolor blush direction on your own face before deciding where the color belongs."
  : googleImageSource
    ? "Found this guide in Google Images? Compare the three placement directions, then preview watercolor blush on your own selfie."
    : "Blush placement changes the shape people notice first. Compare three directions before you apply color.";
---

<SeoLandingLayout
  title={page.title}
  description={page.description}
  heroImage={heroImage}
  ogImage={heroImage}
  heroCtaHref={tryonHref}
  heroCtaLabel="Preview Watercolor Blush Free"
  googleImageRetentionPath="/guides/blush-placement-map"
  faq={page.faq}
>
  <Fragment slot="hero">
    <h1>Blush Placement That Changes the Shape You See</h1>
    <p>{heroBody}</p>
  </Fragment>

  {
    pinterestSource && (
      <PinterestExperimentPanel
        mode="blush-placement"
        kicker="Pinterest blush placement path"
        title="Choose the effect before you place the color"
        body="The Pin gave you a map worth saving. This page keeps the same lift, soften, and freshen choices, then opens Watercolor Blush already selected for one no-sign-up selfie preview."
        primaryHref={tryonHref}
        primaryLabel="Preview blush placement free"
        secondaryHref={pricingHref}
        secondaryLabel="See member benefits"
        proofPoints={[
          "Same direction as the Pin",
          "One no-sign-up preview",
          "Upgrade to save results",
        ]}
        membershipTitle="Save comparisons only when they help"
        membershipBody="The free preview answers whether the blush direction suits your face. Membership is for saved results, more placement comparisons, and HD references."
      />
    )
  }

  <section class="seo-content">
    <h2>Three placements, three different impressions</h2>
    <p>
      Blush does more than add color. Its highest point, width, and distance
      from the center of the face change whether the cheek reads as lifted,
      soft, or freshly flushed. Start with a small amount of cream or liquid
      color and keep every edge diffused into real skin.
    </p>

    <table class="compare-table">
      <thead>
        <tr>
          <th>Placement</th>
          <th>Visual effect</th>
          <th>Application cue</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Lift</strong></td>
          <td>Raises attention toward the outer cheek and temple.</td>
          <td>Keep the strongest color high and blend upward.</td>
        </tr>
        <tr>
          <td><strong>Soften</strong></td>
          <td>Rounds the center of the cheek and softens sharper angles.</td>
          <td>Diffuse color across the apples without dropping it too low.</td>
        </tr>
        <tr>
          <td><strong>Freshen</strong></td>
          <td>Creates a youthful flush close to the eyes and center face.</td>
          <td>Use a very sheer layer high on the cheek.</td>
        </tr>
      </tbody>
    </table>

    <h2>Why watercolor blush works for this test</h2>
    <p>
      A translucent watercolor finish makes placement easier to judge because
      skin remains visible through the color. Heavy opaque pigment can hide the
      direction and make every placement look like the same block of blush.
      Preview the sheer version first, then decide how much intensity you want
      in real life.
    </p>
  </section>

  <section class="seo-cta" slot="cta">
    <div class="seo-cta-inner">
      <h2>See the placement on your own face</h2>
      <p>
        Watercolor Blush opens preselected. Upload one selfie and preview it
        free before choosing where to apply color.
      </p>
      <a href={tryonHref} class="cta-btn">Try Watercolor Blush Free</a>
    </div>
  </section>
</SeoLandingLayout>

<style is:global>
  @media (max-width: 820px) {
    .seo-hero-image {
      order: -1;
      width: min(100%, 340px);
    }
  }
</style>
