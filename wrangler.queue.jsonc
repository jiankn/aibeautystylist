{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aibeautystylist-tryon-queue-consumer",
  "main": "src/workers/tryonQueueConsumer.ts",
  "account_id": "9679290d9ad455c63c2002a90d381bf7",
  "compatibility_date": "2026-06-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-beauty-stylist-db",
      "database_id": "b4ca2fa7-49ea-410e-b802-bb710975d01a",
    },
  ],
  "r2_buckets": [
    {
      "binding": "USER_UPLOADS",
      "bucket_name": "ai-beauty-stylist-user-uploads",
    },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "aibeautystylist-tryon-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "aibeautystylist-tryon-jobs-dlq",
      },
    ],
  },
  "vars": {
    "APP_ENV": "production",
    "APP_PUBLIC_URL": "https://aibeautystylist.com",
    "AI_PROVIDER": "evolink",
    "UPLOAD_PROVIDER": "r2",
    "TRYON_PROVIDER": "evolink",
    "IMAGE_PROVIDER": "evolink",
    "EVOLINK_VISION_MODEL": "doubao-seed-2.0-lite",
    "EVOLINK_VISION_TIMEOUT_MS": "120000",
    "EVOLINK_IMAGE_MODEL": "qwen-image-edit-plus",
    "EVOLINK_IMAGE_FALLBACK_MODEL": "doubao-seedream-5.0-lite",
    "EVOLINK_ACQUISITION_IMAGE_MODEL": "doubao-seedream-5.0-pro",
    "EVOLINK_ACQUISITION_FALLBACK_IMAGE_MODEL": "gpt-image-2",
    "EVOLINK_PRIVATE_IMAGE_MODEL": "doubao-seedream-5.0-pro",
    "EVOLINK_PRIVATE_FALLBACK_IMAGE_MODEL": "gpt-image-2",
    "EVOLINK_IMAGE_TIMEOUT_MS": "180000",
    "SUPPORT_EMAIL": "support@aibeautystylist.com",
  },
}
